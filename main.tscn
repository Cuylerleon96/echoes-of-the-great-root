material_override = SubResource("mat_grey")

; ── WALL JUMP SECTION (blue) ──────────────────────────────────────────────────
; Floor leads into a narrow alley between two tall walls.
; Player wall-jumps up to the reward platform at Y=5.
; Walls are 1.4 units apart (player 0.4 wide → 1.0 of movement space).
; Each wall jump gains ~1 unit height → needs 5 jumps to reach top.


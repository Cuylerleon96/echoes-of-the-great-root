; ── DASH SECTION (orange) ─────────────────────────────────────────────────────
; Drop from wall-jump top (Y=5) to this ledge (Y=3.5) then dash across a 3-unit gap.
; Single jump + move speed cannot cross it. Jump + dash mid-air can.

[node name="DashLedge" type="CSGBox3D" parent="Stage"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1,  21.0, 3.35, 0)
size = Vector3(2.0, 0.3, 2.0)
use_collision = true
collision_layer = 1
material_override = SubResource("mat_orange")

; Gap: X = 22 to 25  (3 units — requires dash)

[node name="DashLanding" type="CSGBox3D" parent="Stage"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1,  26.5, 3.35, 0)
size = Vector3(3.0, 0.3, 2.0)
use_collision = true
collision_layer = 1
material_override = SubResource("mat_orange")

; ── DOUBLE JUMP SECTION (green) ───────────────────────────────────────────────
; Drop from dash landing (Y=3.5) to low platform (Y=1.0).
; High platform is 2.5 units above low platform:
;   Single jump = 1.7 units (cannot reach, top would be at 2.7 < 3.5)
;   Double jump  = 1.7 + 1.7*0.85 = 3.15 units (can reach, lands on 3.5)
; Very-high platform needs another double jump.

